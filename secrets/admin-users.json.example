  {
    "_comment": "totpSecret is optional — omit it entirely to leave 2FA off for an account. When present it must be the AES-256-GCM-encrypted value produced by `npm run admin:create` (see ADMIN_SECRETS_KEY in .env.example), never a raw base32 secret.",
    "email": "with-2fa@example.com",
    "passwordHash": "$2b$10$replace-with-a-real-bcrypt-hash",
    "totpSecret": "v1.<iv-hex>.<authTag-hex>.<ciphertext-hex>"
  }
]
