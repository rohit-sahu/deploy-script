# Public site URL used for absolute metadata (Open Graph, sitemap, robots.txt).
# Set this to your real deployed domain in production.
# Default (when unset) is DEFAULT_SITE_URL in src/data/resume.ts.
NEXT_PUBLIC_SITE_URL=https://rohitkumar.skytech.in

# MongoDB connection used to store the editable resume content (see
# src/lib/mongodb.ts / src/lib/resume-data.ts). A free MongoDB Atlas cluster
# works fine. Reads are served from a local JSON cache file (see
# RESUME_CACHE_FILE below), so MongoDB is only hit on cold start and on
# admin saves, not on every page request.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net
MONGODB_DB=portfolio

# Auth.js (next-auth) — generate with: npx auth secret
AUTH_SECRET=

# Admin accounts for /admin are NOT configured here — they live in
# secrets/admin-users.json (gitignored), a JSON array of { email,
# passwordHash } objects. Copy secrets/admin-users.json.example to get
# started; generate each hash with:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
# Optional override for where that file lives (docker-compose points this
# at the Docker secret mount in production; leave unset for local dev).
ADMIN_USERS_FILE=

# Required only if any admin has 2FA (TOTP) enabled. AES-256-GCM key used to
# encrypt/decrypt the totpSecret field in secrets/admin-users.json — must be
# a base64-encoded 32-byte value. `npm run env:create` generates this for
# you automatically; to create one by hand instead:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep this in your env file (never the same file/mount as admin-users.json)
# so the two secrets are never exposed together. Run `npm run admin:create`
# after setting this to enroll 2FA for an account.
ADMIN_SECRETS_KEY=

# Optional label shown in authenticator apps (Google Authenticator, Authy,
# etc.) next to the 6-digit code, set at enrollment time via admin:create.
# Defaults to "Portfolio Admin" if unset.
ADMIN_TOTP_ISSUER=

# Optional comma-separated allowlist of IPs/CIDR ranges (IPv4 and IPv6)
# permitted to reach /admin/*, e.g. "203.0.113.10,198.51.100.0/24". Leave
# unset to disable (no restriction). Relies on the reverse proxy in front of
# this app (nginx in this stack — see nginx/https.conf.template, or
# Cloudflare's CF-Connecting-IP when using the --tunnel/--quick-tunnel
# Cloudflare Tunnel modes) setting the client IP honestly; provides no
# protection if this app is ever exposed directly to the internet without
# either of those in front of it.
ADMIN_IP_ALLOWLIST=

# Optional override for the resume content read-through cache file (docker-
# compose points this at a persistent named volume in production; leave
# unset for local dev — defaults to ./data/resume-cache.json).
RESUME_CACHE_FILE=
