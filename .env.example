# Public site URL used for absolute metadata (Open Graph, sitemap, robots.txt).
# Set this to your real deployed domain in production.
# Default (when unset) is DEFAULT_SITE_URL in src/data/resume.ts.
NEXT_PUBLIC_SITE_URL=https://rohitkumar.skytech.in

# MongoDB connection used to store the editable resume content (see
# src/lib/mongodb.ts / src/lib/resume-data.ts). A free MongoDB Atlas cluster
# works fine. Reads are served from a local JSON cache file (see
# RESUME_CACHE_FILE below), so MongoDB is only hit on cold start and on
# admin saves, not on every page request.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net
MONGODB_DB=portfolio

# Auth.js (next-auth) — generate with: npx auth secret
AUTH_SECRET=

# Admin accounts for /admin are NOT configured here — they live in
# secrets/admin-users.json (gitignored), a JSON array of { email,
# passwordHash } objects. Copy secrets/admin-users.json.example to get
# started; generate each hash with:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
# Optional override for where that file lives (docker-compose points this
# at the Docker secret mount in production; leave unset for local dev).
ADMIN_USERS_FILE=

# Optional override for the resume content read-through cache file (docker-
# compose points this at a persistent named volume in production; leave
# unset for local dev — defaults to ./data/resume-cache.json).
RESUME_CACHE_FILE=
