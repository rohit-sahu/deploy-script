# Defense-in-depth: reject any plain-HTTP request whose Host header doesn't
# match ${DOMAIN} (e.g. a direct request to this server's public IP, or a
# forged Host header). Primary protection against direct-IP access is still
# the AWS Security Group / host firewall (restricted to Cloudflare's IP
# ranges when CLOUDFLARE_PROXIED=1) -- this is a second layer in case that's
# ever misconfigured or bypassed.
server {
	listen 80 default_server;
	server_name _;
	# Container healthcheck target; must not redirect (avoids following to
    # HTTPS and failing TLS verification against a not-yet-trusted cert).
    location = /healthz {
        access_log off; # Optional: keeps your health checks from bloating logs
        default_type text/plain;
        return 200 "ok";
    }
	# 2. Fallback for everything else drops the connection
    location / {
        return 444;
    }
}

server {
	listen 80;
	server_name ${DOMAIN};

	# Answer ACME HTTP-01 challenges by forwarding to the caddy companion.
	# Host header must be preserved (nginx otherwise defaults it to the
	# upstream's own name, i.e. "caddy") so Caddy's domain-keyed site block
	# actually matches the request instead of falling through to an
	# automatic-HTTPS redirect to the bogus host "caddy".
	location /.well-known/acme-challenge/ {
		proxy_pass http://caddy:80;
		proxy_set_header Host $host;
	}

	# Block all other plain HTTP traffic; force HTTPS.
	location / {
		return 301 https://$host$request_uri;
	}
}

