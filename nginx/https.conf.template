# Defense-in-depth: reject any TLS handshake whose SNI doesn't match
# ${DOMAIN} (e.g. a direct request to this server's public IP). ssl_reject_handshake
# is used instead of `return 444` because the connection must be rejected
# before/during the TLS handshake, before any HTTP request line exists.
# Primary protection is still the AWS Security Group / host firewall -- see
# the note in app.conf.template.
server {
	listen 443 ssl default_server;
	server_name _;
	ssl_reject_handshake on;
}

server {
	listen 443 ssl;
	http2 on;
	server_name ${DOMAIN};

	ssl_certificate     ${CERT_FILE};
	ssl_certificate_key ${KEY_FILE};
	ssl_protocols TLSv1.2 TLSv1.3;
	ssl_prefer_server_ciphers off;
	ssl_session_cache shared:SSL:10m;
	ssl_session_timeout 1d;

	add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;

	location / {
		proxy_pass http://web:3000;
		proxy_http_version 1.1;
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $remote_addr;
		# $remote_addr, not $proxy_add_x_forwarded_for: this nginx is the
		# first hop from the public internet (ports 80/443 are open
		# directly), so a client-supplied X-Forwarded-For must never be
		# trusted/appended-to — $proxy_add_x_forwarded_for would let an
		# attacker prepend a fake IP that the app's getClientIp() (which
		# reads the left-most entry) would wrongly treat as the real client,
		# defeating the /admin IP allowlist and per-IP rate limiting (see
		# src/lib/client-ip.ts and src/proxy.ts in the portfolio app repo).
		proxy_set_header X-Forwarded-For $remote_addr;
		proxy_set_header X-Forwarded-Proto $scheme;
		proxy_set_header Upgrade $http_upgrade;
		proxy_set_header Connection "upgrade";
	}
}
