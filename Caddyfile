{
	admin off
	http_port 80
	https_port 8443
	# Renewal policy: attempt renewal once ~1/3 of the certificate's lifetime
	# remains (~30 days before expiry, for Let's Encrypt's 90-day certs). This
	# is Caddy's own documented default (0.3333) -- set explicitly here for
	# clarity/intent, not because the default needed changing.
	#
	# WARNING: do not set this close to 1.0 (e.g. 0.99) in production. A
	# ratio that high means "renewal window" covers almost the cert's entire
	# lifetime, so Caddy's periodic renewal checks (~every 10 min) will
	# repeatedly attempt to re-issue the same cert. Let's Encrypt's Duplicate
	# Certificate rate limit (5 per exact hostname set per rolling 7 days)
	# will be exhausted within about an hour -- and once rate-limited, Caddy
	# will ALSO fail to renew when the real expiry approaches, causing an
	# actual outage. If you need to force/test a renewal, do it manually
	# (see the "how to renew" runbook) instead of lowering this permanently.
	renewal_window_ratio 0.3333
}

# Cert-only mode: this site block exists solely so Caddy requests/renews a
# real ACME certificate for $DOMAIN (via HTTP-01, proxied here by nginx).
# nginx reads the resulting cert/key straight off the caddy_data volume and
# handles all actual TLS termination and traffic.
{$DOMAIN} {
	respond "ok"
}
